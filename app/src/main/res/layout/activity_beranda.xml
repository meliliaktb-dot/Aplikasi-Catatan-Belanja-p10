
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATATAN BELANJA"
            android:textColor="#198754"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Halo, Selamat Datang!"
            android:textColor="#202020"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvNamaBeranda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pengguna"
            android:textColor="#198754"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#DDF3E5"
            android:padding="20dp"
            android:text="Yuk, atur belanjaanmu hari ini agar lebih mudah dan teratur!"
            android:textColor="#205C39"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Menu Utama"
            android:textColor="#202020"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnKeBelanja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Daftar Belanja"
            android:backgroundTint="#198754"/>

        <Button
            android:id="@+id/btnKePengaturan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Pengaturan"
            android:backgroundTint="#198754"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:text="Catat belanjaanmu, supaya tidak ada yang terlupakan."
            android:textColor="#777777"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>
